DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
PORT=10000
NODE_ENV=production
# Comma-separated origins for a future web manager portal; native Android does not use CORS.
CORS_ORIGINS=
# Enable only on a single Render instance to avoid duplicate scheduled reminders.
ENABLE_REMINDERS=true
